# Ignore temporary Google Drive folders
.tmp.driveupload/
.tmp.drivedownload/

# Ignore local server logs or large zip files
*.log
*.zip

# Ignore local environment files containing credentials
.env
.env.*
config.local.php

# Database backups contain personal and access data. Keep them outside the
# web project; this rule also prevents accidental re-addition if the local
# backup job is temporarily pointed here.
db_backups/

# Ignore macOS system files
.DS_Store
.DS_Store*
