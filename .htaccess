Options -Indexes
RewriteEngine On

# Server-only material must never be routed through the public document root.
RewriteRule ^(?:db_backups|_legacy|scratch|scripts|Documents)(?:/|$) - [F,L,NC]
RewriteRule ^config\.local\.php$ - [F,L,NC]
RewriteRule ^(?:images|uploads)/.*\.(?:php[0-9]?|phtml|phar|cgi|pl)$ - [F,L,NC]

<FilesMatch "(?i)\.(?:sql|bak|bat|md)$">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# PHP entry points send the single authoritative security-header policy from
# security_headers.php. Keeping CSP in both layers caused browser-dependent
# policy intersections and made frame exceptions impossible to reason about.
